# Canonical URL. Defaults to the production domain; set it on a preview deployment
# so canonical tags and the sitemap describe that deployment.
PUBLIC_SITE_URL=https://lifeagentgrowthsystems.com

# Growthmap lead endpoint the contact form POSTs to (playbook §4b). Public by
# design — it is read in the browser.
#
# The form lives in the popup the header's "Contact Us" item opens. While this is
# empty that popup keeps the original LeadConnector ("Trustymail") iframe, so a
# deploy before the endpoint exists never ships a dead form. Set it in Vercel and
# our own static form takes over on the next build.
PUBLIC_CONTACT_ENDPOINT=

# Force the original LeadConnector embed back even once the endpoint is set.
# `growthmap` (default) or `embed`.
PUBLIC_FORM_MODE=growthmap

# Elementor's Google fonts (Inter, Roboto, Montserrat, Poppins, Fira Sans),
# self-hosted here. `on` (default) is what the WordPress site renders. `off` drops
# them and the site falls back to the system stack.
PUBLIC_WEBFONTS=on

# The GoHighLevel chat bubble WordPress loads on every page. `on` (default) or `off`.
PUBLIC_CHAT_WIDGET=on
