# Canonical URL. Defaults to the production domain; set it on a preview deployment
# so canonical tags and the sitemap describe that deployment.
PUBLIC_SITE_URL=https://lifeagentgrowthsystems.com

# Elementor's Google fonts (Inter, Roboto, Montserrat, Poppins, Fira Sans),
# self-hosted here. `on` (default) is what the WordPress site renders. `off` drops
# them and the site falls back to the system stack.
PUBLIC_WEBFONTS=on

# The GoHighLevel chat bubble WordPress loads on every page. `on` (default) or `off`.
PUBLIC_CHAT_WIDGET=on

# Reproduce the WordPress site's own bugs instead of fixing them. `keep` turns off
# every correction in src/lib/fixes.ts — which is what `npm run compare` needs, since
# it diffs the clone against the live WordPress site. Leave unset in production.
PUBLIC_ORIGINAL_BUGS=
