---
/**
 * Page shell for the cloned WordPress pages.
 *
 * The <head> reproduces the original's stylesheet cascade exactly: every handle the
 * WordPress page linked, in the same order, served from public/wp/css/. Elementor's
 * compiled per-post CSS is what makes the clone pixel-accurate, so it ships verbatim
 * rather than being re-derived (playbook §2, §7.1).
 */
import type { PageRecord } from '../lib/pages';
import { fragment, chatWidgetHtml } from '../lib/pages';
import PageContent from '../components/PageContent.astro';
import { CHAT_WIDGET, WEBFONTS } from '../config';
import { FIXES_ON, FIX_CSS, fixPageMeta, fixSeoHead } from '../lib/fixes';
import '../styles/global.css';

interface Props {
  page: PageRecord;
}

const { page } = Astro.props as Props;
const site = Astro.site ?? new URL('https://lifeagentgrowthsystems.com');
const canonical = new URL(page.path, site).href;

// Yoast's block is stored with the origin templated out, so a preview deployment
// describes itself rather than production. The escaped spelling is the one inside
// the JSON-LD graph.
const seoHead = fixSeoHead(
  page.seoHead
    .split('__ORIGIN_ESC__').join(site.origin.replace(/\//g, '\\/'))
    .split('__ORIGIN__').join(site.origin),
);

// Corrections to the stale copy Yoast baked into this page's description and robots
// directive — the home page's search snippet read "We grow roofing companies".
const meta = fixPageMeta(page.path);
const description = meta.description ?? page.description;
const robots = meta.robots ?? page.robots;

/**
 * Elementor's Google-font stylesheets, self-hosted by scripts/build-fonts.mjs.
 * On by default, because that is what production renders: unlike the sibling
 * roofinggrowthsystems site, every `src: url(...)` in these sheets is spelled
 * `https://`, so nothing is blocked as mixed content and the site's real
 * typography arrives. `PUBLIC_WEBFONTS=off` drops them.
 */
const webfonts = WEBFONTS !== 'off';
const css = webfonts ? page.css : page.css.filter((c) => !c.name.startsWith('elementor-gf-local-'));

/**
 * The two faces above the fold on every page: the kit's heading family (Inter) and
 * its body family (Roboto), both from Elementor's own local Google Fonts files.
 */
const PRELOAD_FONTS = webfonts
  ? [
      '/wp/fonts/inter-ucc73fwrk3iltehus_nvmrmxcp50sjia1zl7.woff2',
      '/wp/fonts/roboto-kfo7cnqeu92fr1me7ksn66agldtyluama3yuba.woff2',
    ]
  : [];

const chat = CHAT_WIDGET ? chatWidgetHtml : '';
---

<!doctype html>
<html lang={page.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="profile" href="https://gmpg.org/xfn/11" />
    {robots && <meta name="robots" content={robots} />}
    <title set:html={page.title} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <Fragment set:html={seoHead} />

    {PRELOAD_FONTS.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}

    {css.map((sheet) => <link rel="stylesheet" href={`/wp/css/${sheet.name}.css`} />)}

    {page.favicons.map((icon) => (
      <link rel={icon.rel} href={icon.href} {...(icon.sizes ? { sizes: icon.sizes } : {})} />
    ))}
    {page.tile && <meta name="msapplication-TileImage" content={page.tile} />}

    {FIXES_ON && <style set:html={FIX_CSS} />}

    <slot name="head" />
  </head>

  <body class={page.bodyClass}>
    {page.hasSkipLink && (
      <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
    )}

    {/* WordPress prints this into <head>; the parser moves it here, which is where
        production's DOM has it too. */}
    {chat && <Fragment set:html={chat} />}

    {page.header && <Fragment set:html={fragment(page.header)} />}

    <slot>
      <PageContent html={fragment(page.content)} />
    </slot>

    {/* Through PageContent, not a bare Fragment: the footer carries the
        "Sign up for updates" subscribe form on every page. */}
    {page.footer && <PageContent html={fragment(page.footer)} region="footer" />}

    {/* Popup templates.
        Elementor keeps a popup out of the document until something opens it —
        scripts/inspect-live.mjs finds zero `[data-elementor-type="popup"]` nodes in
        the live pre-open DOM — so they are parked in <template> elements, whose
        content is not in the DOM tree at all. src/scripts/elementor.js clones one in
        (and builds the dialog wrapper around it) when a click matches the template's
        `open_selector`. On this site that selector is `.contact-form`, the header's
        "Contact Us" menu item, and the popup holds the site's only contact form. */}
    {page.popups.map((name) => (
      <template class="gm-popup">
        <PageContent html={fragment(name)} region={name} />
      </template>
    ))}

    <script src="../scripts/elementor.js"></script>
  </body>
</html>
